#!/usr/bin/env bash

set -euo pipefail

usage() {
    printf '%s\n' \
        'usage: agent start' \
        '       agent exec <agent-id> -- <command> [args...]' \
        '       agent apply <agent-id>' \
        '       agent stop <agent-id>' \
        '       agent clear' >&2
    exit 2
}

die() {
    printf 'agent: %s\n' "$*" >&2
    exit 1
}

validate_id() {
    local id=$1
    [[ $id =~ ^[0-9a-f]{8}$ ]] ||
        die "invalid agent ID: $id"
}

generate_id() {
    local id
    id=$(LC_ALL=C od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
    validate_id "$id"
    printf '%s\n' "$id"
}

repo_paths() {
    repo_root=$(git rev-parse --show-toplevel)
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
    main_root=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
    [[ -n $main_root ]] || die 'cannot locate the main worktree'
}

start_agent() {
    repo_paths
    [[ $repo_root == "$main_root" ]] || die 'start agents from the main worktree'

    local state_root=$common_dir/loop-review
    local worktree_root=$main_root/.worktrees/loop-review
    local id=
    local state_dir=
    local workspace=
    local project=
    local temp_dir=
    local worktree_created=false
    local compose_attempted=false
    local complete=false

    mkdir -p "$state_root"
    local candidate
    local attempt
    for ((attempt = 0; attempt < 100; attempt++)); do
        candidate=$(generate_id)
        [[ ! -e $worktree_root/$candidate ]] || continue
        if mkdir "$state_root/$candidate" 2>/dev/null; then
            id=$candidate
            state_dir=$state_root/$id
            workspace=$worktree_root/$id
            project=pgqueue-$id
            break
        fi
    done
    [[ -n $id ]] || die 'cannot allocate an agent ID'

    rollback_failed_start() {
        if [[ $complete == false ]]; then
            set +e
            if [[ $compose_attempted == true ]]; then
                (
                    cd "$workspace"
                    COMPOSE_PROJECT_NAME=$project \
                        PGQUEUE_POSTGRES_PORT=0 \
                        PGQUEUE_DASHBOARD_PORT=0 \
                        docker compose down -v --remove-orphans
                ) >/dev/null 2>&1
            fi
            if [[ $worktree_created == true ]]; then
                git -C "$main_root" worktree remove --force "$workspace" >/dev/null 2>&1
            fi
            if [[ -n $temp_dir ]]; then
                rm -rf -- "$temp_dir"
            fi
            rm -rf -- "$state_dir"
            rmdir "$state_root" 2>/dev/null || true
        fi
    }
    trap rollback_failed_start EXIT

    [[ ! -e $workspace ]] || die "worktree path already exists: $workspace"
    mkdir -p "$worktree_root"

    temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/loop-review-index.XXXXXX")
    local index=$temp_dir/index
    local tree
    GIT_INDEX_FILE=$index git -C "$repo_root" read-tree HEAD
    GIT_INDEX_FILE=$index git -C "$repo_root" add -A -- .
    tree=$(GIT_INDEX_FILE=$index git -C "$repo_root" write-tree)

    git -C "$repo_root" worktree add --detach "$workspace" HEAD >&2
    worktree_created=true
    git -C "$workspace" read-tree --reset -u "$tree"
    git -C "$workspace" reset --mixed --quiet HEAD
    rm -rf -- "$temp_dir"
    temp_dir=

    compose_attempted=true
    (
        cd "$workspace"
        COMPOSE_PROJECT_NAME=$project \
            PGQUEUE_POSTGRES_PORT=0 \
            PGQUEUE_DASHBOARD_PORT=0 \
            docker compose up -d --wait postgres
    ) >&2

    local address
    local port
    address=$(
        cd "$workspace"
        COMPOSE_PROJECT_NAME=$project \
            PGQUEUE_POSTGRES_PORT=0 \
            PGQUEUE_DASHBOARD_PORT=0 \
            docker compose port postgres 5432
    )
    port=${address##*:}
    [[ $port =~ ^[0-9]+$ ]] || die "cannot determine PostgreSQL port from: $address"

    printf '%s\n' "$workspace" >"$state_dir/workspace"
    printf '%s\n' "$project" >"$state_dir/project"
    printf '%s\n' "$main_root" >"$state_dir/main-root"
    printf '%s\n' "$port" >"$state_dir/port"
    printf '%s\n' "$tree" >"$state_dir/initial-tree"

    complete=true
    trap - EXIT

    printf 'Agent ID: %s\nWorkspace: %s\n' "$id" "$workspace" >&2
    printf '%s\n' "$id"
}

load_agent_state() {
    local id=$1
    validate_id "$id"
    repo_paths

    state_dir=$common_dir/loop-review/$id
    [[ -d $state_dir ]] || return 1
    local state_file
    for state_file in workspace project main-root port initial-tree; do
        [[ -f $state_dir/$state_file ]] || die "incomplete state for $id"
    done

    workspace=$(<"$state_dir/workspace")
    project=$(<"$state_dir/project")
    stored_main_root=$(<"$state_dir/main-root")
    port=$(<"$state_dir/port")
    initial_tree=$(<"$state_dir/initial-tree")

    [[ $project == pgqueue-$id ]] || die "invalid project in state for $id"
    [[ $stored_main_root == "$main_root" ]] || die "state belongs to another repository: $id"
    [[ $port =~ ^[0-9]+$ ]] || die "invalid PostgreSQL port in state for $id"
    [[ $workspace == "$main_root/.worktrees/loop-review/$id" ]] ||
        die "invalid worktree path in state for $id"
    git -C "$main_root" cat-file -e "$initial_tree^{tree}" 2>/dev/null ||
        die "invalid initial tree in state for $id"
}

exec_agent() {
    local id=$1
    shift
    [[ ${1:-} == -- ]] || usage
    shift
    (($# > 0)) || usage

    local state_dir workspace project stored_main_root port initial_tree
    load_agent_state "$id" || die "agent ID is not running: $id"

    cd "$workspace"
    export LOOP_REVIEW_AGENT_ID=$id
    export LOOP_REVIEW_SOURCE_ROOT=$main_root
    export LOOP_REVIEW_WORKTREE=$workspace
    export COMPOSE_PROJECT_NAME=$project
    export PGQUEUE_POSTGRES_PORT=0
    export PGQUEUE_DASHBOARD_PORT=0
    export DATABASE_URL=postgres://pgqueue:pgqueue@127.0.0.1:$port/pgqueue
    exec "$@"
}

apply_agent() {
    local id=$1
    local state_dir workspace project stored_main_root port initial_tree
    load_agent_state "$id" || die "agent ID is not running: $id"
    [[ ! -e $state_dir/applied ]] || die "changes already applied for agent ID: $id"

    local temp_dir
    temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/loop-review-apply.XXXXXX")
    local index=$temp_dir/index
    local patch=$temp_dir/changes.patch
    local final_tree

    GIT_INDEX_FILE=$index git -C "$workspace" read-tree HEAD
    GIT_INDEX_FILE=$index git -C "$workspace" add -A -- .
    final_tree=$(GIT_INDEX_FILE=$index git -C "$workspace" write-tree)
    git -C "$workspace" diff --binary --full-index --no-ext-diff \
        "$initial_tree" "$final_tree" >"$patch"

    if [[ -s $patch ]]; then
        git -C "$main_root" apply --check "$patch"
        git -C "$main_root" apply --whitespace=nowarn "$patch"
    fi
    printf '%s\n' "$final_tree" >"$state_dir/applied"
    rm -rf -- "$temp_dir"
    stop_agent "$id"
}

stop_agent() {
    local id=$1
    local state_dir workspace project stored_main_root port initial_tree
    load_agent_state "$id" || return 0

    local status=0
    (
        cd "$workspace"
        COMPOSE_PROJECT_NAME=$project \
            PGQUEUE_POSTGRES_PORT=0 \
            PGQUEUE_DASHBOARD_PORT=0 \
            docker compose down -v --remove-orphans
    ) || status=$?

    if ! git -C "$main_root" worktree remove --force "$workspace"; then
        status=1
    fi

    if ((status == 0)); then
        rm -rf -- "$state_dir"
        rmdir "$common_dir/loop-review" 2>/dev/null || true
        rmdir "$main_root/.worktrees/loop-review" "$main_root/.worktrees" 2>/dev/null || true
    fi
    return "$status"
}

clear_agents() {
    repo_paths
    [[ $repo_root == "$main_root" ]] || die 'clear agents from the main worktree'
    docker info >/dev/null 2>&1 || die 'Docker is unavailable'

    local state_root=$common_dir/loop-review
    local worktree_root=$main_root/.worktrees/loop-review
    local ids=()
    local status=0

    add_id() {
        local id=$1
        if [[ ! $id =~ ^[0-9a-f]{8}$ ]]; then
            printf 'agent: unexpected entry while clearing: %s\n' "$id" >&2
            status=1
            return
        fi
        local existing
        for existing in "${ids[@]}"; do
            [[ $existing == "$id" ]] && return
        done
        ids+=("$id")
    }

    add_project() {
        local project=$1
        if [[ $project =~ ^pgqueue-([0-9a-f]{8})$ ]]; then
            add_id "${BASH_REMATCH[1]}"
        fi
    }

    local path
    if [[ -d $state_root ]]; then
        for path in "$state_root"/*; do
            [[ -d $path ]] || continue
            add_id "${path##*/}"
        done
    fi
    if [[ -d $worktree_root ]]; then
        for path in "$worktree_root"/*; do
            [[ -e $path ]] || continue
            add_id "${path##*/}"
        done
    fi

    local projects
    projects=$(docker ps -a --format '{{.Label "com.docker.compose.project"}}') ||
        die 'cannot inspect Docker containers'
    local project
    while IFS= read -r project; do
        add_project "$project"
    done <<<"$projects"

    local resource_ids
    local resource_id
    resource_ids=$(docker network ls -q --filter label=com.docker.compose.project) ||
        die 'cannot inspect Docker networks'
    for resource_id in $resource_ids; do
        project=$(docker network inspect --format '{{index .Labels "com.docker.compose.project"}}' "$resource_id") || {
            status=1
            continue
        }
        add_project "$project"
    done

    resource_ids=$(docker volume ls -q --filter label=com.docker.compose.project) ||
        die 'cannot inspect Docker volumes'
    for resource_id in $resource_ids; do
        project=$(docker volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "$resource_id") || {
            status=1
            continue
        }
        add_project "$project"
    done

    local id
    local workspace
    for id in "${ids[@]}"; do
        if ! (
            cd "$main_root"
            COMPOSE_PROJECT_NAME=pgqueue-$id \
                PGQUEUE_POSTGRES_PORT=0 \
                PGQUEUE_DASHBOARD_PORT=0 \
                docker compose down -v --remove-orphans
        ); then
            status=1
        fi

        workspace=$worktree_root/$id
        if [[ -e $workspace ]]; then
            git -C "$main_root" worktree remove --force "$workspace" 2>/dev/null ||
                rm -rf -- "$workspace"
        fi
        rm -rf -- "${state_root:?}/$id"
    done

    git -C "$main_root" worktree prune
    rmdir "$state_root" 2>/dev/null || true
    rmdir "$worktree_root" "$main_root/.worktrees" 2>/dev/null || true
    return "$status"
}

case ${1:-} in
    start)
        [[ $# == 1 ]] || usage
        start_agent
        ;;
    exec)
        [[ $# -ge 4 ]] || usage
        exec_agent "$2" "${@:3}"
        ;;
    apply)
        [[ $# == 2 ]] || usage
        apply_agent "$2"
        ;;
    stop)
        [[ $# == 2 ]] || usage
        stop_agent "$2"
        ;;
    clear)
        [[ $# == 1 ]] || usage
        clear_agents
        ;;
    *)
        usage
        ;;
esac
